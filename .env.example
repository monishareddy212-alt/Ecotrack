# EcoTrack Server Configuration
# Render automatically injects PORT and recommends NODE_ENV=production.
PORT=3000
NODE_ENV=production

# Public application URL (optional in Render single-service mode)
APP_URL=https://your-ecotrack-service.onrender.com

# MySQL Database Connection String (Server-only — NEVER prefix with VITE_)
# Cloud MySQL (Aiven / PlanetScale / Railway / AWS RDS):
# Example: mysql://avnadmin:password@mysql-example.aivencloud.com:12345/defaultdb?ssl={"rejectUnauthorized":true}
# Local MySQL:
# Example: mysql://root:password@localhost:3306/ecotrack
DATABASE_URL=your-mysql-connection-string

# Optional SSL override:
# - Set to "false" for local non-SSL MySQL instances
# - Set to "no-verify" for self-signed SSL certificates
# DATABASE_SSL=false

# Express Session Signing Secret (Required in production: minimum 32 random characters)
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

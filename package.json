{
  "name": "ecotrack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build && node ./node_modules/esbuild/bin/esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "node server.js",
    "db:migrate": "node ./node_modules/tsx/dist/cli.mjs server/db/migrate.ts",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs server/db/seeds/seedAll.ts",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test src/utils/*.test.ts server/utils/*.test.ts server/tests/*.test.ts",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive:true, force:true}); fs.rmSync('server.js', {force:true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express-session": "^1.19.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "lucide-react": "^0.546.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
